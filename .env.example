# Copie este arquivo para .env e preencha com suas credenciais reais.
# cp .env.example .env

# =============================================================
# FRONTEND — React (Vite). VITE_* é convenção de build-time: fica embutido
# no bundle do navegador, então NUNCA colocar segredo privilegiado aqui.
# =============================================================

# URL do projeto Supabase (Settings → API → Project URL)
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co

# Chave pública do Supabase (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=<sua-anon-key>

# URLs dos microsserviços Quarkus consumidos pelo frontend-host
VITE_AUTH_API_URL=http://localhost:8082
VITE_CATALOG_API_URL=http://localhost:8083
VITE_PROFILE_API_URL=http://localhost:8084
VITE_SUBSCRIPTION_API_URL=http://localhost:8085

# URL do admin-service (usada por frontend-admin e frontend-host)
VITE_ADMIN_API_URL=http://localhost:8087
# URL do frontend-admin (usada pelo frontend-host para navegação cruzada, se aplicável)
VITE_ADMIN_APP_URL=http://localhost:5200

# Backends de módulo — chamados diretamente pelo respectivo Micro Frontend
VITE_PDF_API_URL=http://localhost:8001
VITE_WHATSAPP_API_URL=http://localhost:8002

# Remotes de Module Federation consumidos pelo frontend-host
VITE_PDF_REMOTE_URL=http://localhost:5101
VITE_WHATSAPP_REMOTE_URL=http://localhost:5102

# =============================================================
# SUPABASE — credenciais privilegiadas (sem prefixo VITE_; nunca usar em bundle
# de frontend). Consumida hoje só pelo admin-service (criação/reset de senha
# de usuários administrativos via Supabase Admin API).
# =============================================================
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<sua-service-role-key>

# =============================================================
# BACKENDS QUARKUS (auth/profile/subscription/module-catalog/usage/admin) —
# mesmo banco Supabase compartilhado nesta fase da migração.
# =============================================================

# Banco de dados — Supabase Transaction Pooler (porta 6543, IPv4 compatível)
# Supabase → Connect → Transaction pooler
# prepareThreshold=0 desativa prepared statements (obrigatório no transaction pooler)
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://<host-do-pooler>:6543/postgres?sslmode=require&prepareThreshold=0
QUARKUS_DATASOURCE_USERNAME=<usuario-do-pooler>
QUARKUS_DATASOURCE_PASSWORD=<senha-do-banco>

# Roles de least-privilege por serviço (opcional — scaffold em
# database/migrations/0051_least_privilege_roles.sql, ainda não aplicado).
# Enquanto não definidas, cada serviço cai no fallback QUARKUS_DATASOURCE_*
# acima (credencial única compartilhada).
# AUTH_DB_USERNAME=
# AUTH_DB_PASSWORD=
# CATALOG_DB_USERNAME=
# CATALOG_DB_PASSWORD=
# PROFILE_DB_USERNAME=
# PROFILE_DB_PASSWORD=
# SUBSCRIPTION_DB_USERNAME=
# SUBSCRIPTION_DB_PASSWORD=
# USAGE_DB_USERNAME=
# USAGE_DB_PASSWORD=
# ADMIN_DB_USERNAME=
# ADMIN_DB_PASSWORD=

# JWT — Supabase (derivado da Project URL, não alterar o padrão)
SUPABASE_JWT_JWKS_URL=https://<seu-projeto>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<seu-projeto>.supabase.co/auth/v1

# CORS — domínios permitidos (um por origem dos 4 micro-frontends ativos +
# frontend legado, ainda de pé em paralelo, ver README).
CORS_ORIGINS=http://localhost:5100,http://localhost:5101,http://localhost:5102,http://localhost:5200

# URL base do Front Host — usada para montar links absolutos (ex.: e-mail de
# convite de membro, profile-service/InvitationService). Deve sempre apontar
# para o frontend "oficial" de aceite de convite (frontend-host), não para o
# frontend legado.
APP_BASE_URL=http://localhost:5100

# auth-service → subscription-service (resolução de acesso a módulo);
# admin-service → subscription-service (ações administrativas sobre
# assinatura, ex.: cancelar/reativar — tabela pertence a subscription-service)
SUBSCRIPTION_SERVICE_URL=http://subscription-service:8085

# Mailer — convites de membro (profile-service) e criação/reset de senha de
# usuários admin (admin-service)
QUARKUS_MAILER_FROM=noreply@localhost
QUARKUS_MAILER_HOST=localhost
QUARKUS_MAILER_PORT=1025
QUARKUS_MAILER_USERNAME=
QUARKUS_MAILER_PASSWORD=

# =============================================================
# BACKEND PYTHON (pdf-service, whatsapp-service)
# =============================================================

# Segredos compartilhados para validar ProfileAccessToken/ModuleAccessToken
# (JWT HMAC-SHA256), emitidos só pelo auth-service. Devem ser IGUAIS aos
# usados pelo Quarkus (app.token.profile-secret / app.token.module-secret) e
# DISTINTOS entre si — nunca reutilizar o mesmo valor para os dois.
# Gere com: openssl rand -hex 32
MODULE_ACCESS_TOKEN_SECRET=<gere-com-openssl-rand-hex-32>
PROFILE_ACCESS_TOKEN_SECRET=<gere-com-openssl-rand-hex-32-diferente-do-anterior>

# Nível de log (DEBUG | INFO | WARNING | ERROR) — pdf-service/whatsapp-service
LOG_LEVEL=INFO
# Formato de log (json | text) — pdf-service/whatsapp-service. "json" é o
# padrão (Google Cloud Logging); use "text" só para depuração local legível.
LOG_FORMAT=json

# PostgreSQL — mesmo banco do Quarkus (asyncpg)
# Formato: postgresql://user:pass@host:port/db
DATABASE_URL=postgresql://<usuario-do-pooler>:<senha-do-banco>@<host-do-pooler>:6543/postgres

# Diretório de armazenamento dos PDFs processados
PDF_STORAGE_PATH=/tmp/saas-pdf
