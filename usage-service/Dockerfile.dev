# syntax=docker/dockerfile:1.4
FROM maven:3.9-eclipse-temurin-21

# libs/platform-module-security-quarkus e libs/platform-database não tem
# repositório Maven privado — instalam no ~/.m2 local do container antes de
# compilar o serviço (ver README.md de cada lib). Contexto de build é a raiz
# do repositório (ver docker-compose.yml).
WORKDIR /libs/platform-module-security-quarkus
COPY libs/platform-module-security-quarkus/pom.xml .
COPY libs/platform-module-security-quarkus/src ./src
RUN mvn install -N -DskipTests -q

WORKDIR /libs/platform-database
COPY libs/platform-database/pom.xml .
COPY libs/platform-database/src ./src
RUN mvn install -N -DskipTests -q

WORKDIR /app
COPY usage-service/pom.xml .
RUN mvn dependency:go-offline -q
COPY usage-service/src ./src
EXPOSE 8086
CMD ["mvn", "quarkus:dev", "-Dquarkus.http.host=0.0.0.0"]
