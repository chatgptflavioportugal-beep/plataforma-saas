INTERNAL_TOKEN=change-me-in-production

# Segredo compartilhado com o Quarkus para validar ModuleAccessToken (JWT HMAC-SHA256)
# Deve ser IGUAL ao MODULE_ACCESS_TOKEN_SECRET do Quarkus
# Gere com: openssl rand -hex 32
MODULE_ACCESS_TOKEN_SECRET=change-me-in-production

LOG_LEVEL=INFO

# PostgreSQL — formato asyncpg: postgresql://user:pass@host:port/db
DATABASE_URL=postgresql://user:pass@host:5432/db

# Diretório de armazenamento dos PDFs processados
PDF_STORAGE_PATH=/tmp/saas-pdf
