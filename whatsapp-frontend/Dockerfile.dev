FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
EXPOSE 5102
# @originjs/vite-plugin-federation não serve remoteEntry.js no dev server (`vite dev`);
# só existe no output de build. Por isso: build em modo watch + preview servindo o dist/.
# O build inicial roda síncrono antes do preview, senão "preview" falha com dist/ inexistente.
CMD ["sh", "-c", "npm run build && (npm run dev & npm run preview)"]
