VITE_SUPABASE_URL=https://[project].supabase.co
VITE_SUPABASE_ANON_KEY=[anon_key]
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_API_URL=http://localhost:8082
VITE_CATALOG_API_URL=http://localhost:8083
VITE_PROFILE_API_URL=http://localhost:8084
VITE_SUBSCRIPTION_API_URL=http://localhost:8085

# Link exibido pelo ClientAreaGuard quando uma conta administrativa tenta
# entrar na área de clientes — aponta para o projeto frontend-admin, separado.
VITE_ADMIN_APP_URL=http://localhost:5200

# Usados só em build-time pelo vite.config.ts (Module Federation remotes) —
# não são VITE_* consumidos em runtime pelo código React.
VITE_PDF_REMOTE_URL=http://localhost:5101
VITE_WHATSAPP_REMOTE_URL=http://localhost:5102
