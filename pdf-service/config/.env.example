# Copie para .env.dev (ou .env.<AMBIENTE>, ver config.py) e preencha.
# cp .env.example .env.dev

# Segredo compartilhado para validar ModuleAccessToken (JWT HMAC-SHA256).
# Deve ser IGUAL ao usado pelo auth-service (app.token.module-secret).
MODULE_ACCESS_TOKEN_SECRET=<mesmo-valor-do-auth-service>

# Nível de log (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Origens permitidas para CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5100,http://localhost:5101

# PostgreSQL — mesmo banco do Quarkus (asyncpg)
# Formato: postgresql://user:pass@host:port/db
DATABASE_URL=postgresql://<usuario>:<senha>@<host>:6543/postgres

# Diretório de armazenamento dos PDFs processados
PDF_STORAGE_PATH=/tmp/saas-pdf
